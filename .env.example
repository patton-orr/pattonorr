# Copy to .env.local and fill in. Do not commit real secrets.
# Locally these live in .env.local; in production they're set in Vercel.

# --- Database (Neon Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection — used by db:migrate. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# --- Auth.js (Google sign-in) ---
# `openssl rand -base64 32`. Also the key material for WHOOP token encryption —
# note prod tokens can't be decrypted locally because this differs per env.
AUTH_SECRET=
# Google OAuth client (Google Cloud console). While the OAuth app is in
# "Testing", only listed test users can sign in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- ESV API (Bible reader) ---
# Token from https://api.esv.org/ — passages are fetched server-side.
ESV_API_TOKEN=

# --- WHOOP (owner's private health integration) ---
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# --- Cron ---
# Shared secret guarding the public /api/whoop/sync cron endpoint.
CRON_SECRET=
